# Build context for docker/backend.Dockerfile is ./backend.
# The image only COPYs pom.xml and src/, but everything here is still uploaded to
# the Docker daemon first, so excluding build output keeps the context ~60 MB
# smaller and stops a host-built jar from ever shadowing the one built in-image.

# Maven build output (the image runs its own `mvn package`)
target/

# Secrets must never enter a build context
.env
.env.*
!.env.example

# Local/IDE/OS noise
.git
.gitignore
.idea/
.vscode/
*.iml
*.log
.DS_Store
Thumbs.db
desktop.ini

# Editor and backup leftovers
*.bak
*.orig
*.tmp
*~

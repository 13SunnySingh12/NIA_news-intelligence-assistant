# Build context for docker/ai-service.Dockerfile is ./ai-service.
# .venv/ alone is ~117 MB of Windows-specific binaries that are useless in a
# linux/amd64 image and would silently bloat every build if left in the context.

# Local virtualenv and Python caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Tests are not needed at runtime (the image only COPYs app/)
tests/

# Secrets must never enter a build context
.env
.env.*
!.env.example

# Local/IDE/OS noise
.git
.gitignore
.idea/
.vscode/
*.log
.DS_Store
Thumbs.db
desktop.ini

# Editor and backup leftovers
*.bak
*.orig
*.tmp
*~

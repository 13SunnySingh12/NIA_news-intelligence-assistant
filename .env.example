# =============================================================================
# NIA — Environment template (COMMIT THIS FILE; values are placeholders)
# Copy to `.env` at the repo root and fill in real values. ONE file for all
# services:
#   • Spring Boot  — DotenvEnvironmentPostProcessor loads it in local dev
#   • FastAPI      — pydantic-settings reads it (env_file)
#   • Vite/React   — envDir='..'; ONLY VITE_* keys are exposed to the browser
# In production, set real environment variables on Render/Vercel instead.
# Never commit the real .env. Never put a secret behind a VITE_* name.
# =============================================================================

# ---------------------------------------------------------------------------
# 1. Application configuration (Spring Boot)
# ---------------------------------------------------------------------------
NIA_INGEST_ENABLED=true
NIA_INGEST_CRON=0 0 */2 * * *
# Max articles embedded per cycle (keeps embedding within the provider rate limit;
# the backlog is worked off over successive cycles).
NIA_EMBED_MAX_PER_CYCLE=100
# Storage guard: delete articles older than this many days (bookmarked/read ones
# are always kept). REQUIRED on a free Supabase plan (500 MB) — without it the
# articles table grows forever. Rough sizing: ~3.3 KB per article.
#   2-hour ingestion (~2-3k articles/day)  -> 7 days is comfortable
#   10-min ingestion (~20-30k articles/day) -> use 3-4 days
NIA_RETENTION_ENABLED=true
NIA_ARTICLE_RETENTION_DAYS=7
NIA_RETENTION_CRON=0 5 * * * *
NIA_INGEST_CATEGORIES=technology,business,world,india,science,sports,health,entertainment,politics
NIA_INGEST_COUNTRIES=us,in,gb
NIA_DEFAULT_LANGUAGE=en
NIA_RAG_TOP_K=8
NIA_PERSONALIZATION_WEIGHTS=0.5,0.25,0.15,0.1

# ---------------------------------------------------------------------------
# 2. Supabase (URL + anon key are public; service-role key + JWT secret are SECRET)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ---------------------------------------------------------------------------
# 3. Database connection (backends only — Supabase Postgres, session pooler)
# ---------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=your-db-password
DATABASE_URL=postgresql://postgres.<project-ref>:your-db-password@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# 4. News providers (Spring Boot). Google News RSS needs no key.
# ---------------------------------------------------------------------------
NEWS_PROVIDER_PRIMARY=GNEWS
NEWS_PROVIDER_SECONDARY=NEWSDATA
NEWS_PROVIDER_FALLBACK=GUARDIAN,CURRENTS,GOOGLE_NEWS_RSS
GNEWS_API_KEY=
NEWSDATA_API_KEY=
GUARDIAN_API_KEY=
CURRENTS_API_KEY=
NEWSAPI_API_KEY=

# ---------------------------------------------------------------------------
# 5. LLM providers (FastAPI) — task-specific routing
#    Each AI task uses the provider best suited to it. AI_FALLBACK_PROVIDER is a
#    comma-separated chain tried in order when the primary fails, so the provider
#    order is configuration rather than code (e.g. chat: GEMINI -> GROQ -> OPENROUTER).
#    All keys are backend-only (never VITE_*).
# ---------------------------------------------------------------------------
# Task -> provider routing
AI_CHAT_PROVIDER=GEMINI
AI_SUMMARY_PROVIDER=GROQ
AI_CLASSIFICATION_PROVIDER=GROQ
AI_EMBED_PROVIDER=GEMINI
AI_FALLBACK_PROVIDER=OPENROUTER

# Provider API keys (placeholders — never commit real values)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Models (configurable via env; never hardcoded in application logic)
GEMINI_CHAT_MODEL=gemini-3.5-flash
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_MODEL=openrouter/free

# Embeddings (Gemini). EMBED_DIM MUST match the vector DB column: VECTOR(768).
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
# Texts per embedding API call. Gemini's hard limit is 100, but its free tier
# rate-limits large batches (429), so keep this modest.
EMBED_BATCH_SIZE=20
ENABLE_LOCAL_EMBED_FALLBACK=false

# HTTP timeouts for the AI service (seconds). CHAT_TIMEOUT must stay below the
# Spring Boot internal client timeout so Spring never cancels a live answer.
CHAT_TIMEOUT=35
EMBED_TIMEOUT=15

# ---------------------------------------------------------------------------
# 6. Internal service communication (Spring Boot <-> FastAPI). Never in the browser.
# ---------------------------------------------------------------------------
FASTAPI_BASE_URL=http://localhost:8000
NIA_INTERNAL_TOKEN=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# 7. CORS (Spring Boot)
# ---------------------------------------------------------------------------
NIA_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# 8. Frontend (Vite) — ONLY these VITE_* values reach the browser.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_API_BASE_URL=http://localhost:8080
